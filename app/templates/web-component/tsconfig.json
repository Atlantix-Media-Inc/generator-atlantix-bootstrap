{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["es2022", "dom", "dom.iterable"],
    "declaration": true,                    
    "experimentalDecorators": true,         
    "useDefineForClassFields": false,       
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
